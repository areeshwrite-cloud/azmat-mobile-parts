# Firebase project configuration (get these from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WhatsApp business number in international format, no + or spaces (e.g. 923001234567)
VITE_WHATSAPP_NUMBER=923197900202

# Public site base URL, used to build shareable product links
VITE_SITE_URL=http://localhost:5173
